# Bu dosyayı ".env" olarak kopyala ve kendi bilgilerinle doldur.
# ".env" dosyasını asla GitHub'a yükleme (aşağıdaki .gitignore zaten engelliyor).

DJANGO_SECRET_KEY=buraya-uzun-rastgele-bir-anahtar-yaz
